{
  "name": "arctic-coverage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:py": "pytest tests/ -q",
    "test": "npm run test:py && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://coverage.skryer.ca playwright test",
    "copy:worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run copy:worker",
    "prebuild": "npm run copy:worker",
    "lint": "eslint .",
    "test:a11y": "playwright test tests/e2e/console.spec.ts -g accessibility"
  },
  "dependencies": {
    "maplibre-gl": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.0"
  }
}