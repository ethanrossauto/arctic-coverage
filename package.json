{
  "name": "arctic-coverage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:js": "esbuild src/playback.ts --bundle --format=esm --outfile=.build/playback.mjs --log-level=error && node --test tests/js/*.test.mjs",
    "test:py": "pytest tests/ -q",
    "test": "npm run test:js && npm run test:py"
  },
  "dependencies": {
    "maplibre-gl": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "esbuild": "^0.25.0"
  }
}
